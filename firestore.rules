rules_version = '2';

// 소방체크 Firestore 보안 규칙
//
// ⚠️ 배포 전 확인
//   1. Firebase 콘솔(Firestore > 규칙)의 현재 규칙과 비교한다.
//      같은 프로젝트(fire-5a8f3)를 다른 앱이 쓰고 있다면 그 컬렉션 규칙을 합쳐야 한다(아래 기본 거부 규칙 때문).
//   2. 콘솔 '규칙 플레이그라운드'로 파일 하단 체크리스트의 시나리오를 확인한다.
//   3. 배포: `firebase deploy --only firestore:rules` 또는 콘솔에 붙여넣기.
//
// 클라이언트 코드(js/firebase.js)의 권한 확인은 화면 표시용일 뿐이며, 실제 권한 경계는 이 규칙이다.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- 공통 함수 ----------
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // 최고 관리자: js/firebase.js의 ADMIN_EMAIL과 동일, 이메일 인증 필수
    function isSuperAdmin() {
      return signedIn()
        && request.auth.token.email == 'lcjun37@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function hasUserDoc() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // 운영자: admin 또는 manager
    function isStaff() {
      return isSuperAdmin() || (hasUserDoc() && myRole() in ['admin', 'manager']);
    }

    function isAdminRole() {
      return isSuperAdmin() || (hasUserDoc() && myRole() == 'admin');
    }

    function validRole(r) {
      return r in ['free', 'freeBusiness', 'paid', 'paidBusiness', 'manager', 'admin'];
    }

    function optString(data, key, maxLen) {
      return !(key in data) || data[key] == null || (data[key] is string && data[key].size() <= maxLen);
    }

    function validProfile(data) {
      return optString(data, 'email', 320)
        && optString(data, 'displayName', 100)
        && optString(data, 'photoURL', 2048);
    }

    // 광고 설정: 이미지는 https, 링크는 http(s). 따옴표·꺾쇠·공백 등 URL 밖의 문자는 허용하지 않음
    function validAd(d) {
      return d.keys().hasOnly(['imageUrl', 'linkUrl', 'isActive', 'updatedAt', 'updatedBy'])
        && d.imageUrl is string
        && (d.imageUrl == '' || d.imageUrl.matches('^https://[A-Za-z0-9._~:/?#\\[\\]@!$&()*+,;=%-]{1,2000}$'))
        && d.linkUrl is string
        && (d.linkUrl == '' || d.linkUrl.matches('^https?://[A-Za-z0-9._~:/?#\\[\\]@!$&()*+,;=%-]{1,2000}$'))
        && d.isActive is bool;
    }

    // ---------- 회원 ----------
    match /users/{uid} {
      allow read: if isOwner(uid) || isStaff();

      // 본인 최초 생성: role은 free (최고 관리자 본인만 admin)
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'role', 'lastLoginAt', 'createdAt'])
        && request.resource.data.uid == uid
        && (request.resource.data.role == 'free'
            || (isSuperAdmin() && request.resource.data.role == 'admin'))
        && validProfile(request.resource.data);

      // 본인 갱신: 프로필·접속시각만. role 변경은 최고 관리자 본인의 admin 승격만 허용
      // 운영자 갱신: 다른 회원의 role만. manager는 admin 부여·admin 변경 불가
      allow update: if (
          isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['email', 'displayName', 'photoURL', 'lastLoginAt', 'role'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
              || (isSuperAdmin() && request.resource.data.role == 'admin'))
          && validProfile(request.resource.data)
        ) || (
          isStaff() && !isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'updatedAt'])
          && validRole(request.resource.data.role)
          && (isAdminRole()
              || (request.resource.data.role != 'admin' && resource.data.role != 'admin'))
        );

      allow delete: if false;
    }

    // ---------- 검색 기록 (본인 것만) ----------
    match /searchHistory/{docId} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['userId', 'userEmail', 'address', 'jibunAddress', 'roadAddress', 'bcode', 'buildingData', 'createdAt']);
      allow update: if false;
    }

    // ---------- 즐겨찾기 (본인 것만, 메모만 수정) ----------
    match /favorites/{docId} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['userId', 'userEmail', 'address', 'jibunAddress', 'roadAddress', 'bcode', 'buildingData', 'createdAt', 'memo']);
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memo', 'updatedAt'])
        && request.resource.data.memo is string
        && request.resource.data.memo.size() <= 500;
    }

    // ---------- 공유 링크 (누구나 생성·조회, 형식 엄격 검증, 수정·삭제·목록 불가) ----------
    match /shares/{shareId} {
      allow get: if true;
      allow list: if false;
      allow create: if shareId.matches('^[A-Za-z0-9]{6,12}$')
        && request.resource.data.keys().hasOnly(['sigunguCd', 'bjdongCd', 'bun', 'ji', 'createdAt'])
        && request.resource.data.sigunguCd is string && request.resource.data.sigunguCd.matches('^[0-9]{5}$')
        && request.resource.data.bjdongCd is string && request.resource.data.bjdongCd.matches('^[0-9]{5}$')
        && request.resource.data.bun is string && request.resource.data.bun.matches('^[0-9]{0,4}$')
        && request.resource.data.ji is string && request.resource.data.ji.matches('^[0-9]{0,4}$')
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // ---------- 사이트 설정 (공개 읽기, 운영자 쓰기) ----------
    match /settings/{settingId} {
      allow read: if true;
      allow create, update: if isStaff()
        && (settingId != 'advertisement' || validAd(request.resource.data));
      allow delete: if isAdminRole();
    }

    // ---------- 그 외 전부 거부 ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// 규칙 플레이그라운드 체크리스트 (배포 전 확인)
//  [허용] 로그인 사용자 A: users/A 생성 {uid:A, role:'free', ...}
//  [거부] 로그인 사용자 A: users/A 생성 {role:'admin'}  / users/A 갱신 {role:'paid'}
//  [거부] 로그인 사용자 A: users/B 읽기·갱신
//  [허용] 관리자 이메일(인증됨): users/{본인} 생성·갱신 {role:'admin'}
//  [허용] admin: users/B 갱신 {role:'manager', updatedAt}
//  [거부] manager: users/B 갱신 {role:'admin'} / admin인 회원의 role 변경
//  [허용] 사용자 A: userId==A인 searchHistory·favorites 생성·조회·삭제, favorites 메모 수정(500자 이하)
//  [거부] 사용자 A: userId==B 문서 조회·삭제
//  [허용] 비로그인: shares/{8자리} 생성 {sigunguCd:'11680', bjdongCd:'10300', bun:'0012', ji:'', createdAt: 서버시각}
//  [거부] shares 덮어쓰기·삭제·목록 조회, 형식이 다른 값
//  [허용] 누구나 settings/advertisement 읽기 / [거부] 일반 사용자 쓰기, 따옴표가 든 imageUrl
